[
  {
    "overlay": true,
    "block_align": "left",
    "text_height": "{{vh(0.34)}}",
    "common_spacing": "{{vh(0.4)}}",
    "middle_spacing": "{{vh(0.04)}}",
    "padding": "{{vh(2)}}",
    "left_top": {
      "text_segments": [
        {
          "text": "{{ (exif.CameraModelName|default('')) }}",
          "color": "white",
          "font_path": "AlibabaPuHuiTi-2-85-Bold.otf",
          "is_bold": true,
          "trim": true
        }
      ],
      "height": "{{vh(0.80)}}",
      "color": "(255,255,255,255)",
      "processor_name": "multi_rich_text"
    },
    "left_bottom": {
      "processor_name": "rich_text",
      "text": "{{ (exif.DateTimeOriginal or exif.CreateDate or exif.DigitalCreationDate or exif.DateCreated or exif.DateTimeCreated or exif.DigitalCreationDateTime|default(''))[:10] | replace(':', '-') }} ©{{ (exif.DateTimeOriginal or exif.CreateDate or exif.DigitalCreationDate or exif.DateCreated or exif.DateTimeCreated or exif.DigitalCreationDateTime|default(''))[:4] | replace(':', '-') }} ALsW",
      "font_path": "AlibabaPuHuiTi-2-45-Light.otf",
      "is_bold": true,
      "height": "{{vh(0.50)}}",
      "color": "(255,255,255,255)"
    },
  
    "left_logo": "{{auto_logo('my') |replace('\\', '/')}}",
    "delimiter_color": "(255,255,255,255)",
    "delimiter_width": "{{vh(0.05)}}",
    "auto_color": true,
    "opacity": 130,
    "processor_name": "watermark"
  }
]
